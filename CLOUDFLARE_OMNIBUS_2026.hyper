## 📜 APPENDIX: REF. CONFIGURATION (wrangler.toml)

```toml
name = "elen-galaxia-core"
main = "src/lib.rs"
compatibility_date = "2024-12-20"

# --- COMPUTE ---
[durable_objects]
bindings = [{ name = "AGENT_DO", class_name = "AgentActor" }]

# --- DATA ---
[d1_databases]
binding = "DB"
database_name = "kilo-core"
database_id = "xxxx"

[[r2_buckets]]
binding = "ASSETS"
bucket_name = "kilo-assets"

# --- INTELLIGENCE ---
[ai]
binding = "AI"

[[vectorize]]
binding = "MEMORY"
index_name = "agent-embeddings"

# --- MESSAGING ---
[[queues.producers]]
queue = "task-queue"
binding = "QUEUE"

[[queues.consumers]]
queue = "task-queue"
max_batch_size = 100
max_batch_timeout = 5

# --- WORKFLOWS ---
[workflows]
binding = "ORCHESTRATOR"
class_name = "AgentWorkflow"
```

